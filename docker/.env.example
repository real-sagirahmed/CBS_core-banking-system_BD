# PostgreSQL Database Configuration
POSTGRES_DB=cbs_production
POSTGRES_USER=cbs_admin
POSTGRES_PASSWORD=ReplaceWithStrongProductionPassword123!#
POSTGRES_PORT=5432

# Redis In-Memory Cache Configuration
REDIS_PASSWORD=ReplaceWithStrongRedisPassword123!#
REDIS_PORT=6379

# Gateway Ingress Port
HTTP_PORT=80
HTTPS_PORT=443

# CBS Security Tokens
JWT_SECRET_KEY=ReplaceWith64ByteCryptographicallyRandomSecretKeyForHmacSha256!
